# Optional. Without it, library download stats come from the public
# pypistats.org API and the page says so. With it, stats come from
# https://api.pepy.tech/api/v2/projects/requests (header X-API-Key).
# Create a key at https://pepy.tech — do not commit it.
PEPY_API_KEY=

# Port for `uv run python app.py`. Responder's own default is 5042.
PORT=5042
